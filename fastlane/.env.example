# Environment variables for Fastlane
# Copy this file to .env.default and fill in real values
# DO NOT commit .env.default to version control

HUAWEI_CLIENT_ID=your_client_id_here
HUAWEI_CLIENT_SECRET=your_client_secret_here
HUAWEI_APP_ID=your_app_id_here

# Same variables app/build.gradle.kts signs with; the path is relative to app/.
SIGNING_KEYSTORE=../release.keystore
SIGNING_STORE_PASSWORD=your_keystore_password
SIGNING_KEY_ALIAS=qrcode
SIGNING_KEY_PASSWORD=your_key_password

# Optional: override the version from gradle.properties for this build.
# AppGallery rejects a re-used version code, so bump it for every upload.
# VERSION_CODE=2
# VERSION_NAME=1.1
